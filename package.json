{
  "name": "is-this-tasty",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "pnpm --filter @is-this-tasty/mobile start",
    "start": "pnpm --filter @is-this-tasty/mobile start",
    "android": "pnpm --filter @is-this-tasty/mobile android",
    "android:build": "pnpm --filter @is-this-tasty/mobile exec expo run:android --device",
    "ios": "pnpm --filter @is-this-tasty/mobile ios",
    "web": "pnpm --filter @is-this-tasty/mobile web",
    "reset-project": "pnpm --filter @is-this-tasty/mobile reset-project",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "tokens": "pnpm --filter @is-this-tasty/ui tokens",
    "check": "pnpm lint && pnpm typecheck && pnpm --filter @is-this-tasty/ui test && pnpm --filter @is-this-tasty/ui check:contrast && pnpm --filter @is-this-tasty/ui check:tokens"
  }
}
